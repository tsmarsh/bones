#compdef bones

_bones() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a commands
  commands=(
    'init:Initialize a new book project'
    'pdf:Build PDF (default)'
    'tex:Generate LaTeX'
    'docx:Build DOCX'
    'epub:Build EPUB'
    'txt:Generate plain text files for TTS'
    'mp3:Generate MP3 audiobook'
    'lineedit:Run LLM line editor (style/consistency review)'
    'copyedit:Run LLM copy editor (grammar edits, saved to git branch)'
    'update-workflows:Update GitHub Actions workflows from templates'
    'list:Show chapter order'
    'clean:Remove build artifacts'
    'distclean:Remove all build artifacts'
    'help:Show help message'
    'check-tools:Check for required tools'
  )

  _arguments '1: :->command'

  case $state in
    command)
      _describe 'bones command' commands
      ;;
  esac
}

_bones "$@"
